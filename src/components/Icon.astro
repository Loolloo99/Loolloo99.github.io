---
import { ICONS, type IconName } from "../lib/icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const classes = ["icon", className].filter(Boolean).join(" ");
const svg = ICONS[name].replace("<svg ", `<svg class="${classes}" `);
---

<Fragment set:html={svg} />
