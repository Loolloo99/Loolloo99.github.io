{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "portfolio-dist",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "-S",
        "localhost:8081",
        "-t",
        "dist"
      ],
      "port": 8081
    },
    {
      "name": "portfolio-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "astro",
        "preview",
        "--port",
        "4322"
      ],
      "port": 4322
    }
  ]
}
