---
import { Image } from "astro:assets";
import { getLanguage } from "../config";
import { useTranslations } from "../i18n/ui";
import { projectUrl, type Project } from "../lib/projects";
import CodePreview from "./CodePreview.astro";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  /** Posizione nel gruppo, mostrata nell'etichetta "01 · PHP + JAVASCRIPT · LARAVEL" */
  index?: number;
  /**
   * La card è in un gruppo che non è quello del linguaggio principale del progetto:
   * resta nascosta nella vista "Tutti" e compare nella scheda del linguaggio
   */
  secondary?: boolean;
}

const { project, index, secondary = false } = Astro.props;
const { data } = project;
const t = useTranslations(project.lang);
const languages = data.languages.map(getLanguage);
const language = languages[0];
const cover = data.screenshots[0];
const number = index ? String(index).padStart(2, "0") : "";
const label = [languages.map((l) => l.name).join(" + "), ...data.frameworks].join(" · ");
const external = { target: "_blank", rel: "noopener noreferrer" };
---

<article
  class="card"
  style={`--c:${language.color}`}
  data-frameworks={data.frameworks.join("|")}
  data-secondary={secondary ? "" : undefined}
  data-inspect="components/ProjectCard.astro"
  hidden={secondary}
>
  <div class="card__media">
    {
      cover ? (
        <Image src={cover} alt={t("card.screenshot", { title: data.title })} widths={[400, 800]} sizes="(max-width: 720px) 100vw, 360px" />
      ) : (
        <CodePreview project={project} />
      )
    }
  </div>
  <div class="card__body">
    <div class="meta">
      <span class="meta__lang">{number && <span class="meta__n">{number} · </span>}{label}</span>
      {data.year && <span>{data.year}</span>}
    </div>
    <h3 class="card__title"><a class="card__link" href={projectUrl(project)}>{data.title}</a></h3>
    <p class="card__summary">{data.summary}</p>
    {data.tags.length > 0 && <ul class="chips">{data.tags.map((tag) => <li class="chip">{tag}</li>)}</ul>}
    <div class="card__foot">
      <div class="links">
        {data.github && <a class="btn btn--sm" href={data.github} {...external}><Icon name="github" />{t("card.code")}</a>}
        {data.demo && <a class="btn btn--sm" href={data.demo} {...external}><Icon name="external" />Demo</a>}
        {!data.github && <span class="private"><Icon name="lock" />{t("card.private")}</span>}
      </div>
      <span class="card__more" aria-hidden="true">{t("card.open")}</span>
    </div>
  </div>
</article>
